{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    /* Imports carry a real `.ts` extension so `node src/api/server.ts` runs the
       sources directly via native type stripping. `rewriteRelativeImportExtensions`
       makes the emitted build reference `.js` instead. */
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    /* Node runs these sources by stripping types, not by compiling them. Enums,
       namespaces and constructor parameter properties cannot be stripped, so the
       compiler should reject them here rather than at `npm run dev`. */
    "erasableSyntaxOnly": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "skipLibCheck": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
