dist/
coverage/
backups/

# Files the person attached to a conversation. They live inside the workspace so
# the agent's tools can read them, but they are conversation state, not source.
.eunoia/

# Local environment: holds the DeepSeek API key.
.env
.env.local

.DS_Store
*.log

# Editor and tool state that is not part of the project.
.idea/
.vscode/

# Vendored study material: a 500 MB clone of an unrelated project, with its own
# git history. It is not source this repository maintains — eslint ignores it
# for the same reason. Keeping it out of the index means `git status` and
# `git add .` stay usable.
reference/
docs/myfree

.npm-cache/

# Headless Chrome profile created by `npm run browser:check`.
.chrome-check-*

# Personal/local images accidentally picked up by an earlier commit.
/portrait_30KB.jpg
/证件照_30K.jpg
/resource/*.png

# Diagnostic request captures can contain conversation text; keep them local.
/docs/captures/model-request-*.json
