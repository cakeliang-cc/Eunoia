{
  "name": "eunoia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A long-term INFP companion agent: stable personality behaviour, layered personal memory, and narrative continuity.",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node --experimental-strip-types scripts/copy-assets.ts && node --experimental-strip-types scripts/build-info.ts",
    "start": "node --env-file-if-exists=.env --experimental-sqlite --disable-warning=ExperimentalWarning dist/api/server.js",
    "test": "NODE_OPTIONS='--experimental-sqlite --disable-warning=ExperimentalWarning' vitest run",
    "test:watch": "NODE_OPTIONS='--experimental-sqlite --disable-warning=ExperimentalWarning' vitest",
    "test:coverage": "NODE_OPTIONS='--experimental-sqlite --disable-warning=ExperimentalWarning' vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm test",
    "lint": "eslint .",
    "dev": "node --env-file-if-exists=.env --experimental-sqlite --disable-warning=ExperimentalWarning --experimental-strip-types src/api/server.ts",
    "migrate": "node --env-file-if-exists=.env --experimental-sqlite --disable-warning=ExperimentalWarning --experimental-strip-types src/db/migrate.ts",
    "eval": "node --env-file-if-exists=.env --experimental-sqlite --disable-warning=ExperimentalWarning --experimental-strip-types src/evaluation/cli.ts",
    "eval:replay": "node --env-file-if-exists=.env --experimental-sqlite --disable-warning=ExperimentalWarning --experimental-strip-types src/evaluation/cli.ts --replay",
    "cleanup": "node --env-file-if-exists=.env --experimental-sqlite --disable-warning=ExperimentalWarning --experimental-strip-types src/privacy/cli.ts",
    "backup": "node --env-file-if-exists=.env --experimental-sqlite --disable-warning=ExperimentalWarning --experimental-strip-types scripts/backup.ts",
    "smoke": "NODE_OPTIONS='--experimental-sqlite --disable-warning=ExperimentalWarning' vitest run tests/smoke",
    "sandbox": "node --env-file-if-exists=.env --experimental-sqlite --disable-warning=ExperimentalWarning --experimental-strip-types src/sandbox/cli.ts",
    "sandbox:check": "node --env-file-if-exists=.env --experimental-sqlite --disable-warning=ExperimentalWarning --experimental-strip-types scripts/sandbox-security-check.ts",
    "sandbox:smoke": "node --env-file-if-exists=.env --experimental-sqlite --disable-warning=ExperimentalWarning --experimental-strip-types scripts/sandbox-smoke.ts",
    "sandbox:it": "NODE_OPTIONS='--experimental-sqlite --disable-warning=ExperimentalWarning' SANDBOX_INTEGRATION=1 vitest run tests/sandbox/integration.docker.test.ts",
    "migrate:legacy": "node --env-file-if-exists=.env --experimental-sqlite --disable-warning=ExperimentalWarning --experimental-strip-types scripts/migrate-legacy-postgres.ts",
    "backup:verify": "node --experimental-strip-types scripts/verify-media-backup.ts",
    "cleanup:media": "node --env-file-if-exists=.env --experimental-sqlite --disable-warning=ExperimentalWarning --experimental-strip-types src/media/cli.ts",
    "browser:check": "node --experimental-strip-types scripts/browser-check.ts",
    "experiment:transcript": "node --experimental-strip-types scripts/model-transcript-experiment.ts",
    "experiment:transcript:live": "node --env-file-if-exists=.env --experimental-strip-types scripts/model-transcript-experiment.ts --live",
    "toolkit:doctor": "node --env-file-if-exists=.env --experimental-strip-types scripts/toolkit-doctor.ts",
    "toolkit:setup": "node --env-file-if-exists=.env --experimental-strip-types scripts/toolkit-setup.ts",
    "acceptance:manifest": "node --experimental-strip-types scripts/acceptance-manifest.ts --write",
    "acceptance:check": "node --experimental-strip-types scripts/acceptance-manifest.ts --check"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@openai/agents": "^0.18.0",
    "ajv": "^6.15.0",
    "openai": "^7.2.0",
    "sharp": "^0.35.5",
    "typescript": "^5.7.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/mcp": "^0.0.80",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "typescript-language-server": "^6.0.3",
    "vitest": "^3.0.0"
  }
}
