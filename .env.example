# DeepSeek API key. Required.
#
# `ANTHROPIC_AUTH_TOKEN` is also accepted as a fallback because this development
# environment already has it set, and it is a working DeepSeek key on every
# route. Prefer DEEPSEEK_API_KEY going forward — the other name is misleading
# once the runtime is OpenAI-format.
DEEPSEEK_API_KEY=

# Postgres, with pgvector. Start it with `docker compose up -d`, then
# `npm run migrate`. Port 5433 is deliberate: 5432 is usually already taken by a
# local Postgres, and silently writing to that one is the failure this avoids.
#
# Unset is allowed and means the in-memory store is used — convenient in
# development, unacceptable in production, since nothing survives a restart. The
# server says which one it selected at startup.
# DATABASE_URL=postgres://designfree:designfree@localhost:5433/designfree

# Port for the HTTP server. Optional, defaults to 8787.
# PORT=8787

# Set to 1 to run the live smoke test against the real endpoint.
# `npm test` never needs this; the smoke test is gated behind it so the default
# suite stays offline and free.
# RUN_SMOKE=1
