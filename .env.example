# DeepSeek API key。必填。
#
# `ANTHROPIC_AUTH_TOKEN` 也可以作为退路，因为当前开发环境已经设了它，
# 而它在每条路由上都是一个可用的 DeepSeek key。今后请优先用
# DEEPSEEK_API_KEY —— 运行时改成 OpenAI 格式之后，另一个名字会误导人。
DEEPSEEK_API_KEY=

# Postgres + pgvector。用 `docker compose up -d` 启动，再跑 `npm run migrate`。
# 端口 5433 是有意选的：5432 通常已经被本机的 Postgres 占着，而"悄悄写进
# 那一个库"正是这里要避开的失败。
#
# POSTGRES_PASSWORD 和 DATABASE_URL 里的密码必须是同一个；compose 用前者
# 初始化容器，服务用后者连接。不要再用 designfree 这种默认口令。
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://designfree:replace-with-a-long-random-password@127.0.0.1:5433/designfree

# 单用户模式：还没有登录功能，所以开发时所有请求都属于同一个人。
# 填一个 UUID（也会作为 users.id）。设了它之后 cookie 不再决定身份，
# 换浏览器、清 cookie、开隐私窗口，看到的都是同一份历史和记忆。
# 留空则退回按 cookie 区分用户（测试和将来接登录时用）。
# 本机当前用的 UUID 写在 .env 里；新环境可以生成一个：
# SINGLE_USER_ID=00000000-0000-4000-8000-000000000001

# ----------------------------------------------------------- model/provider ---
# 模型和 provider 是分开的：model profile 决定 context window / 默认预算，
# provider 决定怎么连。会话可以单独 pin 一个 modelId。
# COMPANION_MODEL_ID=deepseek-v4-pro
# MODEL_PROVIDER=deepseek
# SESSION_SUMMARY_MODEL=deepseek-flash

# ---------------------------------------------------------------- session ---
# 所有值都有代码默认值；这里列出来是为了让限制可见、可改。
# 不设 SESSION_INPUT_BUDGET_TOKENS 时，使用模型 profile 的默认预算
# （DeepSeek 为 200k）；设了就是显式上限，仍会被模型 context 截住。
# 8k 留给 system prompt/记忆/关系块，达到 85% 时触发压缩；
# 压缩后保留最近 8 条、最多 4000 tokens 的原文。
# SESSION_COMPACTION_ENABLED=true
# SESSION_INPUT_BUDGET_TOKENS=200000
# SESSION_PROMPT_RESERVE_TOKENS=8000
# SESSION_COMPACT_TRIGGER_RATIO=0.85
# SESSION_COMPACT_KEEP_RECENT_MESSAGES=8
# SESSION_COMPACT_KEEP_RECENT_TOKENS=4000
# SESSION_COMPACT_MIN_MESSAGES=12
# SESSION_SUMMARY_TARGET_TOKENS=2000
# SESSION_SUMMARY_MAX_INPUT_TOKENS=64000
# 0 = 关闭空闲压缩；开启示例：60
# SESSION_IDLE_COMPACT_MINUTES=0
# SESSION_COMPACT_CHECK_INTERVAL_SECONDS=60
# SESSION_IDLE_SCAN_LIMIT=200
# mixed = 中文约 1 字 1 token、英文约 4 字符 1 token；也可用 chars4
# SESSION_TOKEN_ESTIMATOR=mixed
# SESSION_REPLAY_MAX_MESSAGES=4000
# SESSION_LIST_LIMIT=30
# SESSION_MESSAGE_LIMIT=200

# HTTP 服务的地址。默认只绑本机 127.0.0.1。
# 没有认证之前不要设成 0.0.0.0——那等于把整个记忆库交给同网段的任何人。
# HOST=127.0.0.1

# HTTP 服务的端口。可选，默认 8787。
# PORT=8787

# 设为 1 则对真实端点跑 live smoke test。
# `npm test` 从不需要它；smoke test 被它门控，这样默认套件保持离线且免费。
# RUN_SMOKE=1
