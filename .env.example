# DeepSeek API key。必填。
#
# `ANTHROPIC_AUTH_TOKEN` 也可以作为退路，因为当前开发环境已经设了它，
# 而它在每条路由上都是一个可用的 DeepSeek key。今后请优先用
# DEEPSEEK_API_KEY —— 运行时改成 OpenAI 格式之后，另一个名字会误导人。
DEEPSEEK_API_KEY=

# 存储：默认 SQLite 单文件，不需要 Docker 或 Postgres 服务。
# 默认是 data/eunoia.sqlite；也可以给绝对路径或放到别的盘。
# SQLITE_PATH=/Users/you/.eunoia/eunoia.sqlite
#
# 临时内存模式：重启后一切丢失，只用于试验/测试。
# STORE=memory

# 单用户模式：还没有登录功能，所以开发时所有请求都属于同一个人。
# 填一个 UUID（也会作为 users.id）。设了它之后 cookie 不再决定身份，
# 换浏览器、清 cookie、开隐私窗口，看到的都是同一份历史和记忆。
# 留空则退回按 cookie 区分用户（测试和将来接登录时用）。
# 本机当前用的 UUID 写在 .env 里；新环境可以生成一个：
# SINGLE_USER_ID=00000000-0000-4000-8000-000000000001

# ----------------------------------------------------------- model/provider ---
# 模型和 provider 是分开的：model profile 决定 context window / 默认预算，
# provider 决定怎么连。会话可以单独 pin 一个 modelId。
# COMPANION_MODEL_ID=deepseek-v4-pro
# MODEL_PROVIDER=deepseek
# SESSION_SUMMARY_MODEL=deepseek-flash

# ---------------------------------------------------------------- session ---
# 所有值都有代码默认值；这里列出来是为了让限制可见、可改。
# 不设 SESSION_INPUT_BUDGET_TOKENS 时，使用模型 profile 的默认预算
# （DeepSeek 为 200k）；设了就是显式上限，仍会被模型 context 截住。
# 8k 留给 system prompt/记忆/关系块，达到 85% 时触发压缩；
# 压缩后保留最近 8 条、最多 4000 tokens 的原文。
# SESSION_COMPACTION_ENABLED=true
# SESSION_INPUT_BUDGET_TOKENS=200000
# SESSION_PROMPT_RESERVE_TOKENS=8000
# SESSION_COMPACT_TRIGGER_RATIO=0.85
# SESSION_COMPACT_KEEP_RECENT_MESSAGES=8
# SESSION_COMPACT_KEEP_RECENT_TOKENS=4000
# SESSION_COMPACT_MIN_MESSAGES=12
# SESSION_SUMMARY_TARGET_TOKENS=2000
# SESSION_SUMMARY_MAX_INPUT_TOKENS=64000
# 长任务检查点（ADR 035）。默认开启：编码任务压缩时保留任务/约束、文件、
# 验证、待确认与下一步，并追加系统记录的工具证据。
# SESSION_CHECKPOINT_ENABLED=true
# auto 按工具轨迹/任务板判断模板；也可强制 coding 或 companion。
# SESSION_CHECKPOINT_MODE=auto
# 0 = 关闭空闲压缩；开启示例：60
# SESSION_IDLE_COMPACT_MINUTES=0
# SESSION_COMPACT_CHECK_INTERVAL_SECONDS=60
# SESSION_IDLE_SCAN_LIMIT=200
# mixed = 中文约 1 字 1 token、英文约 4 字符 1 token；也可用 chars4
# SESSION_TOKEN_ESTIMATOR=mixed
# SESSION_REPLAY_MAX_MESSAGES=4000
# SESSION_LIST_LIMIT=30
# SESSION_MESSAGE_LIMIT=200

# --------------------------------------------------- model transcript (032) ---
# legacy = 只重放 user/assistant 聊天历史（升级安全默认）。
# durable = 持久化模型轨迹、背景状态基线与阶段边界；本部署已通过 A01–A32 与
# S01–S03 后显式开启。回滚只需改回 legacy 并重启，不降级数据库。
# MODEL_TRANSCRIPT_MODE=durable

# HTTP 服务的地址。默认只绑本机 127.0.0.1。
# 没有认证之前不要设成 0.0.0.0——那等于把整个记忆库交给同网段的任何人。
# HOST=127.0.0.1

# 允许的 Host 头。默认只接受 127.0.0.1 / localhost / [::1]，以及 HOST 给出的具体
# 地址；其他 Host 一律 403。绑 0.0.0.0 或用自定义域名时，必须在这里列出来。
#
# 这是 DNS rebinding 的防线：只绑 loopback 并不能阻止攻击者把域名解析到
# 127.0.0.1，而在那种请求里 Origin 和 Host 都是攻击者的名字，同源检查会通过。
# EUNOIA_ALLOWED_HOSTS=dev.internal,my-box.local

# HTTP 服务的端口。可选，默认 8787。
# PORT=8787

# 设为 1 则对真实端点跑 live smoke test。
# `npm test` 从不需要它；smoke test 被它门控，这样默认套件保持离线且免费。
# RUN_SMOKE=1

# --------------------------------------------------------------- workspace ---
# 让 agent 读写一个代码目录。不设 WORKSPACE_ROOT 时，它只有记忆工具，没有任何
# 文件或命令能力——这是默认的、安全的状态。
#
# 路径只用环境变量给，绝不能从聊天请求里来：那等于让模型自己挑沙箱。
# 只接受相对路径写在 WORKSPACE_ROOT 里；绝对路径和 .. 会被拒绝。
# .env / *.pem / id_rsa 这类凭据文件默认既不读也不写。
#
# WORKSPACE_ROOT=/Users/you/Projects/your-repo
#
# 写入和命令是分开的两个开关。想让 agent 看代码，不等于允许它改文件，更不等于
# 允许它跑 npm install。两个都默认关闭。
# WORKSPACE_WRITES=1
# WORKSPACE_COMMANDS=1
#
# 工作台网页终端，默认关闭。打开后，网页会以当前用户身份在宿主机上执行你输入的
# 命令（不经过沙箱，也不经过权限层）。它要求 loopback 请求、Host 白名单、
# X-Workspace-UI 头和每进程生成的 X-Eunoia-Token。
# WORKSPACE_TERMINAL=1
#
# 额外忽略的目录，逗号分隔；node_modules、.git、dist 等已经在默认列表里。
# WORKSPACE_IGNORE=reference,vendor
#
# 打开后凭据文件也会被读写。只在完全信任的环境里用。
# WORKSPACE_ALLOW_SENSITIVE=1
#
# 一轮对话里模型/工具最多走几步。默认 12，范围 1–50。
# AGENT_MAX_STEPS=12

# ------------------------------------------------------------------ skills ---
# 技能是流程，不是工具。配置了 WORKSPACE_ROOT 后，默认发现：
#   <WORKSPACE_ROOT>/.eunoia/skills/
#   <WORKSPACE_ROOT>/.agents/skills/
# 以及随服务发布的内置技能。技能文件改了要重启服务。
# 设为 false 可以关掉整个技能层（索引和 skill 都不会出现）。
# SKILLS_ENABLED=true

# ----------------------------------------------------------------- sandbox ---
# ADR 017 / 018。设置 WORKSPACE_ROOT 后，文件与命令工具不再在宿主机执行，
# 而是通过 Sandbox Gateway 进入隔离容器。沙箱是唯一执行路径；没有配置好时
# 服务会拒绝启动，而不是退回宿主机执行。
#
# 必须提供不可变的镜像 digest（tag 会漂移，恢复时不能重新拉一个新版本）：
#   docker image inspect --format '{{.Id}}' <image>
# 然后把结果填到这里：
# SANDBOX_IMAGE_DIGEST=sha256:...
#
# 运行时客户端：开发机用 docker；生产用 nerdctl + containerd + gVisor。
# SANDBOX_RUNTIME_CLIENT=docker
#
# 隔离等级。默认 gvisor，并要求运行时真的注册了 runsc；不可用时拒绝执行，
# 不会静默降级到 runc。macOS 开发机没有 runsc 时，必须显式承认：
# SANDBOX_RUNTIME_CLASS=runc
# SANDBOX_ALLOW_NON_GVISOR=1
#
# 运行时的固定参数（不是给模型看的）：
# SANDBOX_RUNTIME_BINARY=docker
# SANDBOX_NERDCTL_NAMESPACE=eunoia
# SANDBOX_NERDCTL_ADDRESS=/run/containerd/containerd.sock
# SANDBOX_SECCOMP_PROFILE=/etc/eunoia/seccomp.json
# SANDBOX_APPARMOR_PROFILE=eunoia-sandbox
#
# 工作区：bind 直接挂 WORKSPACE_ROOT（单用户本机模式）；copy 为每个 task 复制
# 一份到 SANDBOX_WORKSPACE_ROOT，多任务之间不能互相看见。
# SANDBOX_WORKSPACE_MODE=bind
# SANDBOX_WORKSPACE_ROOT=/absolute/path/to/sandbox-storage
#
# 资源默认值来自 small/default/large profile，可被下面的变量覆盖：
# SANDBOX_RESOURCE_PROFILE=default
# SANDBOX_CPU=2
# SANDBOX_MEMORY_MB=4096
# SANDBOX_PIDS=512
# SANDBOX_TIMEOUT_MS=1800000
# SANDBOX_OUTPUT_LIMIT_BYTES=262144
# SANDBOX_IDLE_TIMEOUT_MS=3600000
# SANDBOX_MAX_CONCURRENT_GLOBAL=4
# SANDBOX_MAX_CONCURRENT_USER=2
# SANDBOX_MAX_CONCURRENT_TASK=1
# SANDBOX_HEARTBEAT_MS=30000
#
# 网络默认全关（--network none）。需要联网时必须同时提供出口网络和代理：
# SANDBOX_NETWORK_MODE=proxy_only
# SANDBOX_EGRESS_NETWORK=eunoia-egress
# SANDBOX_PROXY_URL=http://host.docker.internal:8788
# SANDBOX_ALLOWED_DOMAINS=registry.npmjs.org,api.example.com
# SANDBOX_ALLOWED_PORTS=443
#
# 也可显式禁用：SANDBOX_ENABLED=0（此时不会注册任何文件/命令工具）。
#
# ------------------------------------------------- permission modes (020) ---
# 四种模式：read-only / auto / on-request / restricted。默认由写入/命令开关推导：
#   两者都关 → read-only；只开一个 → on-request；都开 → auto。
# auto 模式下，需要审批的低风险操作会先过 auto-review；其余模式等人。
# SANDBOX_PERMISSION_MODE=auto
#
# 可信控制面（CLI）允许切换到的模式上限：
# SANDBOX_PERMISSION_ALLOWED_MODES=read-only,auto,on-request,restricted
#
# auto-review：默认只在 auto 模式开启。它只能批准策略允许的风险等级，
# 永远不能覆盖 system deny，也不能扩大 restricted 白名单。
# SANDBOX_AUTO_REVIEW=1
# SANDBOX_AUTO_APPROVE_RISK=low,medium
# SANDBOX_REQUIRE_HUMAN_RISK=high,critical
# SANDBOX_AUTO_REVIEW_TTL_MS=600000
# SANDBOX_APPROVAL_TTL_MS=900000
# SANDBOX_PERMISSION_REQUEST_TTL_MS=1800000
#
# 审批身份。CLI 的 --by 会记录在这里配置的操作员 id 下；agent id 一律拒绝。
# SANDBOX_OPERATOR_ID=operator
# SANDBOX_ORGANIZATION_ID=default
# SANDBOX_PROJECT_ID=default
#
# restricted 的显式白名单。写路径为空时，工作区挂载是只读的。
# SANDBOX_RESTRICTED_READ=/workspace
# SANDBOX_RESTRICTED_WRITE=/workspace/tests
# SANDBOX_RESTRICTED_TOOLS=read,list_dir,glob,grep,bash
# SANDBOX_RESTRICTED_NETWORK_MODE=none
# SANDBOX_RESTRICTED_DOMAINS=registry.npmjs.org
# SANDBOX_RESTRICTED_PORTS=443
#
# 运维命令：
#   npm run sandbox -- status
#   npm run sandbox -- recover
#   npm run sandbox -- permissions --task <taskId>
#   npm run sandbox -- mode --task <taskId> --mode read-only [--minutes 30]
#   npm run sandbox -- requests --task <taskId>
#   npm run sandbox -- approvals --task <taskId>
#   npm run sandbox -- approve-request --approval <id> --by alice [--scope once|task|session]
#   npm run sandbox -- deny-request --approval <id> --by alice
#   npm run sandbox -- grants --task <taskId>
#   npm run sandbox -- approve --task <taskId> --action fs.write --scope /workspace --minutes 10
#   npm run sandbox -- revoke --task <taskId> --approval <id>
#   npm run sandbox -- sweep
#   npm run sandbox -- gc --idle-minutes 60
#   npm run sandbox -- proxy --listen 0.0.0.0:8788
#   npm run sandbox:check


# ---------------------------------------------------------------- media -----
# Private image storage. Default: a `media/` directory next to the SQLite file.
# MEDIA_ROOT=./data/media
# Per-image / per-message byte limits, long-edge of the request variant, and the
# decode concurrency gate. The server publishes these to the client; the client
# does not keep a second copy.
# MEDIA_MAX_IMAGES_PER_MESSAGE=5
# MEDIA_MAX_IMAGE_BYTES=10485760
# MEDIA_MAX_MESSAGE_IMAGE_BYTES=20971520
# MEDIA_MAX_DIMENSION=8192
# MEDIA_MAX_PIXELS=40000000
# MEDIA_MAX_CONCURRENT_DECODES=2
# MEDIA_REQUEST_LONG_EDGE=2048
# MEDIA_MAX_REQUEST_BODY_BYTES=33554432
# MEDIA_UNBOUND_GRACE_MS=86400000
# MEDIA_LEASE_MS=300000


# ------------------------------------------------------------------ MCP ----
# External MCP servers are off by default; each is added and enabled from the
# "外部服务" panel. None of these switches enables a server by itself.
#
# Allow a configuration to run a stdio server as a trusted *host* process.
# This is not a sandbox; the management UI says so. Default: off.
# The local Playwright browser preset requires this and should only be enabled
# on a single-user workstation.
# MCP_ALLOW_HOST_PROCESS=0
#
# Allow HTTP servers on loopback/private addresses (and plain http for them).
# MCP_ALLOW_PRIVATE_NETWORK=0
# MCP_ALLOW_INSECURE=1
#
# Master key for persisted OAuth tokens and client registrations.
# 32 bytes, base64 or 64 hex. Never commit it; backups do not include it.
# Without it, anonymous and env-reference servers still work, and OAuth refuses
# to persist rather than storing plaintext.
# EUNOIA_MCP_KEY=
# EUNOIA_MCP_KEY_FILE=
#
# OAuth callback must be loopback. Override only if the app runs on another port.
# MCP_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/api/mcp/oauth/callback
#
# Container image digest and docker binary for sandboxed stdio servers.
# MCP_DOCKER_BINARY=docker
# MCP_SANDBOX_DISABLED=1
#
# Secrets a configuration may reference. The value is read at connect time and
# registered with the process redactor; references outside MCP_/EUNOIA_MCP_ are
# refused. Example:
# MCP_GITHUB_TOKEN=
# MCP_DOCS_TOKEN=

# Developer toolkit -----------------------------------------------------------
# Search key for the Tavily adapter; independent from the model provider.
# Without it, web_search returns WEB_NOT_CONFIGURED rather than empty results.
# TAVILY_API_KEY=
#
# Allow web_fetch to reach loopback/private addresses. Off by default; enabling
# it disables the SSRF protection for those destinations.
# WEB_ALLOW_PRIVATE_NETWORK=0
#
# Browser output directory for Playwright MCP screenshots/traces.
# EUNOIA_BROWSER_OUTPUT_DIR=./data/browser-output

# --- Agent Team / Subagent (optional) -------------------------------------
# TEAM_ENABLED=1
# TEAM_WORKSPACE_ROOT=~/.eunoia/team-workspaces
# TEAM_MAX_MEMBERS=4
# TEAM_MAX_CONCURRENT_REQUESTS=3
# TEAM_MAX_DEPTH=2
# TEAM_MAX_ACTIVATIONS=32
# TEAM_MAX_MODEL_REQUESTS=64
# TEAM_MAX_TASKS=256
# TEAM_MAX_MESSAGES=128
# TEAM_MAX_MESSAGE_CHARS=4000
# TEAM_MAX_QUEUED_MESSAGES=16
# TEAM_MAX_AUTO_ACTIVATIONS=8
# TEAM_MAX_BROADCAST_FANOUT=8
# TEAM_MAX_INPUT_TOKENS=400000
# TEAM_MAX_OUTPUT_TOKENS=32000
# TEAM_MAX_REQUESTS=24
# TEAM_MAX_COST_USD=
